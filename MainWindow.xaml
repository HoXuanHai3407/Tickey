<Window x:Class="StickyNotePremium.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sticky Note Premium"
        Width="790"
        Height="240"
        MinWidth="650"
        MinHeight="210"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="{Binding AlwaysOnTop}"
        ShowInTaskbar="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{Binding ForegroundBrush}" />
            <Setter Property="Background" Value="#22000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#44000000" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{Binding ForegroundBrush}" />
            <Setter Property="Background" Value="#22000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#66000000" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#44000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Foreground" Value="{Binding ForegroundBrush}" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#36FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Margin" Value="0,9,0,4" />
        </Style>

        <Style x:Key="SettingTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="SmallActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="Foreground" Value="#1F2937" />
        </Style>
    </Window.Resources>

    <Border x:Name="MainSurface"
            CornerRadius="12"
            Background="{Binding SolidBackgroundBrush}"
            MouseLeftButtonDown="MainSurface_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.30" />
        </Border.Effect>

        <Grid>
            <!-- This isolated layer is also sampled by the glass card via VisualBrush. -->
            <Grid x:Name="BackgroundVisual" IsHitTestVisible="False">
                <Border Background="{Binding SolidBackgroundBrush}" CornerRadius="12" />
                <Border Background="{Binding BackgroundBrush}" CornerRadius="12" />
            </Grid>

            <Border Background="{Binding OverlayBrush}"
                    CornerRadius="12"
                    IsHitTestVisible="False" />

            <Grid Margin="24,8,24,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="19" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="88" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="25" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding SummaryText}"
                           Foreground="{Binding ForegroundBrush}"
                           FontSize="15"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Row="1"
                           Text="{Binding MonthSummaryText}"
                           Foreground="{Binding ForegroundBrush}"
                           Opacity="0.88"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="‹"
                            Click="PreviousEventButton_Click"
                            ToolTip="Xem sự kiện trước" />
                    <TextBlock Width="410"
                               Margin="12,0"
                               Text="{Binding CurrentEventName}"
                               Foreground="{Binding ForegroundBrush}"
                               FontSize="15"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="›"
                            Click="NextEventButton_Click"
                            ToolTip="Xem sự kiện tiếp theo" />
                </StackPanel>

                <Border x:Name="GlassCountdownCard"
                        Grid.Row="3"
                        Width="380"
                        Height="78"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#22FFFFFF"
                        BorderBrush="#70FFFFFF"
                        BorderThickness="1"
                        CornerRadius="18"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.24" />
                    </Border.Effect>
                    <Grid>
                        <!-- Center-aligned snapshot of the note background; BlurEffect gives the card a seamless glass feel. -->
                        <Border CornerRadius="18" Opacity="0.72">
                            <Border.Background>
                                <VisualBrush Visual="{Binding ElementName=BackgroundVisual}"
                                             Stretch="None"
                                             AlignmentX="Center"
                                             AlignmentY="Center" />
                            </Border.Background>
                            <Border.Effect>
                                <BlurEffect Radius="22" KernelType="Gaussian" />
                            </Border.Effect>
                        </Border>

                        <Border Background="#22FFFFFF" CornerRadius="18" />
                        <Border BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="18" />
                        <Border Height="1"
                                Margin="22,1,22,0"
                                VerticalAlignment="Top"
                                Background="#88FFFFFF"
                                Opacity="0.65" />

                        <Grid Margin="14,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding Days, StringFormat={}{0:00}}" Foreground="{Binding ForegroundBrush}" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="NGÀY" Foreground="{Binding ForegroundBrush}" Opacity="0.86" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Grid>
                            <Border Grid.Column="1" Background="#38FFFFFF" Margin="0,8" />
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding Hours, StringFormat={}{0:00}}" Foreground="{Binding ForegroundBrush}" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="GIỜ" Foreground="{Binding ForegroundBrush}" Opacity="0.86" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Grid>
                            <Border Grid.Column="3" Background="#38FFFFFF" Margin="0,8" />
                            <Grid Grid.Column="4">
                                <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding Minutes, StringFormat={}{0:00}}" Foreground="{Binding ForegroundBrush}" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="PHÚT" Foreground="{Binding ForegroundBrush}" Opacity="0.86" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Grid>
                            <Border Grid.Column="5" Background="#38FFFFFF" Margin="0,8" />
                            <Grid Grid.Column="6">
                                <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding Seconds, StringFormat={}{0:00}}" Foreground="{Binding ForegroundBrush}" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="GIÂY" Foreground="{Binding ForegroundBrush}" Opacity="0.86" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="4"
                           Text="{Binding TargetDateText}"
                           Foreground="{Binding ForegroundBrush}"
                           FontSize="13"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <Button Grid.Row="5"
                        Height="20"
                        Padding="10,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{Binding SelectionModeText}"
                        Foreground="{Binding ForegroundBrush}"
                        Background="#20FFFFFF"
                        BorderBrush="#55FFFFFF"
                        BorderThickness="1"
                        FontSize="10"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="AutoModeButton_Click"
                        ToolTip="Bấm để quay về tự động chọn sự kiện gần nhất" />
            </Grid>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,7,7,0">
                <ToggleButton Style="{StaticResource ToolbarToggleStyle}"
                              Content="📌"
                              IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"
                              ToolTip="Ghim nổi trên màn hình" />
                <Button x:Name="SettingsButton"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Content="⚙"
                        Click="SettingsButton_Click"
                        ToolTip="Cài đặt" />
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Content="—"
                        Click="MinimizeButton_Click"
                        ToolTip="Thu nhỏ" />
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Content="×"
                        Click="CloseButton_Click"
                        ToolTip="Đóng" />
            </StackPanel>

            <Popup x:Name="SettingsPopup"
                   IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}"
                   PlacementTarget="{Binding ElementName=SettingsButton}"
                   Placement="Bottom"
                   HorizontalOffset="-485"
                   VerticalOffset="6"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   PopupAnimation="Fade">
                <Border Width="530"
                        MaxHeight="720"
                        Background="#FFFDFDFD"
                        BorderBrush="#22000000"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.30" />
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="Cài đặt Sticky Note Premium"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#111827"
                                           VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right"
                                        Width="28"
                                        Height="28"
                                        Content="×"
                                        FontSize="16"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="CloseSettings_Click" />
                            </DockPanel>

                            <DockPanel Margin="0,13,0,6">
                                <TextBlock Text="Sự kiện / ngày lễ"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#111827" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding Events.Count, StringFormat={}{0} sự kiện}"
                                           Foreground="#6B7280"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <ListBox Height="145"
                                     ItemsSource="{Binding Events}"
                                     SelectedItem="{Binding SelectedManagedEvent, Mode=TwoWay}"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1"
                                     Background="White"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="#1F2937"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TargetDateTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                       Foreground="#6B7280"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource SmallActionButtonStyle}"
                                        Content="+ Sự kiện mới"
                                        Click="NewEventButton_Click" />
                                <Button Style="{StaticResource SmallActionButtonStyle}"
                                        Content="Lưu"
                                        Background="#E8F2FF"
                                        BorderBrush="#93C5FD"
                                        Click="SaveEventButton_Click" />
                                <Button Style="{StaticResource SmallActionButtonStyle}"
                                        Content="Xóa"
                                        Background="#FEF2F2"
                                        BorderBrush="#FCA5A5"
                                        Foreground="#B91C1C"
                                        Click="DeleteEventButton_Click" />
                            </StackPanel>

                            <TextBlock Text="Tên sự kiện" Style="{StaticResource SettingLabelStyle}" />
                            <TextBox Style="{StaticResource SettingTextBoxStyle}"
                                     Text="{Binding EditEventName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ngày đích" Style="{StaticResource SettingLabelStyle}" />
                                    <DatePicker Height="32"
                                                SelectedDate="{Binding EditTargetDate, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Giờ (HH:mm)" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBox Style="{StaticResource SettingTextBoxStyle}"
                                             Text="{Binding EditTargetTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,9,0,0"
                                       Text="Sự kiện đã qua vẫn được giữ trong danh sách. Chế độ AUTO chỉ chọn sự kiện tương lai gần nhất."
                                       Foreground="#6B7280"
                                       FontSize="11"
                                       TextWrapping="Wrap" />

                            <CheckBox Margin="0,12,0,2"
                                      Content="Luôn ghim nổi trên các cửa sổ khác"
                                      IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"
                                      Foreground="#374151" />

                            <Separator Margin="0,12,0,3" />

                            <TextBlock Text="Màu nền" Style="{StaticResource SettingLabelStyle}" />
                            <DockPanel LastChildFill="True">
                                <TextBox Width="120"
                                         Margin="0,0,10,0"
                                         Style="{StaticResource SettingTextBoxStyle}"
                                         Text="{Binding BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Width="28" Height="28" Margin="2" Background="#C92533" Tag="#C92533" BorderBrush="#D1D5DB" Click="ColorPreset_Click" ToolTip="Đỏ" />
                                    <Button Width="28" Height="28" Margin="2" Background="#F59E0B" Tag="#F59E0B" BorderBrush="#D1D5DB" Click="ColorPreset_Click" ToolTip="Cam" />
                                    <Button Width="28" Height="28" Margin="2" Background="#FDE68A" Tag="#FDE68A" BorderBrush="#D1D5DB" Click="ColorPreset_Click" ToolTip="Vàng" />
                                    <Button Width="28" Height="28" Margin="2" Background="#10B981" Tag="#10B981" BorderBrush="#D1D5DB" Click="ColorPreset_Click" ToolTip="Xanh lá" />
                                    <Button Width="28" Height="28" Margin="2" Background="#3B82F6" Tag="#3B82F6" BorderBrush="#D1D5DB" Click="ColorPreset_Click" ToolTip="Xanh dương" />
                                    <Button Width="28" Height="28" Margin="2" Background="#7C3AED" Tag="#7C3AED" BorderBrush="#D1D5DB" Click="ColorPreset_Click" ToolTip="Tím" />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Text="Hình nền" Style="{StaticResource SettingLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Height="32" Padding="12,0" Margin="0,0,8,0" Content="Chọn hình..." Click="BrowseBackground_Click" />
                                <Button Height="32" Padding="12,0" Content="Xóa hình nền" Click="ClearBackground_Click" />
                            </StackPanel>
                            <TextBlock Margin="0,5,0,0"
                                       Text="{Binding BackgroundImagePath, TargetNullValue='Chưa chọn hình nền'}"
                                       Foreground="#6B7280"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />

                            <DockPanel Margin="0,9,0,0">
                                <TextBlock Text="Độ rõ hình nền" Style="{StaticResource SettingLabelStyle}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding BackgroundImageOpacity, StringFormat={}{0:P0}}"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <Slider Minimum="0" Maximum="1" TickFrequency="0.05"
                                    Value="{Binding BackgroundImageOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Text="Lớp phủ tối" Style="{StaticResource SettingLabelStyle}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding OverlayOpacity, StringFormat={}{0:P0}}"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <Slider Minimum="0" Maximum="0.65" TickFrequency="0.05"
                                    Value="{Binding OverlayOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Kiểu hiển thị ảnh" Style="{StaticResource SettingLabelStyle}" />
                                    <ComboBox Height="32" SelectedValue="{Binding ImageStretchMode, Mode=TwoWay}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="UniformToFill" />
                                        <ComboBoxItem Content="Uniform" />
                                        <ComboBoxItem Content="Fill" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Màu chữ" Style="{StaticResource SettingLabelStyle}" />
                                    <ComboBox Height="32" SelectedValue="{Binding ForegroundTheme, Mode=TwoWay}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="Auto" />
                                        <ComboBoxItem Content="Light" />
                                        <ComboBoxItem Content="Dark" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,10,0,0"
                                       Text="{Binding ValidationMessage}"
                                       Foreground="#B91C1C"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>

            <Grid x:Name="ResizeGripVisual"
                  Width="22"
                  Height="22"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,2,2"
                  IsHitTestVisible="False">
                <TextBlock Text="◢"
                           Foreground="{Binding ForegroundBrush}"
                           FontSize="12"
                           Opacity="0.55"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>

            <Thumb x:Name="ResizeThumb"
                   Width="24"
                   Height="24"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNWSE"
                   Background="Transparent"
                   BorderThickness="0"
                   DragDelta="ResizeThumb_DragDelta" />
        </Grid>
    </Border>
</Window>
